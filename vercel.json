{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/robots.txt", "destination": "/static/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/static/sitemap.xml" },
    { "source": "/app.js", "destination": "/static/app.js" },
    { "source": "/index.css", "destination": "/static/index.css" },
    { "source": "/dashboard.html", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/sl/:path*", "destination": "/api/index.py" },
    { "source": "/auth/:path*", "destination": "/api/index.py" },
    { "source": "/", "destination": "/api/index.py" }
  ]
}
